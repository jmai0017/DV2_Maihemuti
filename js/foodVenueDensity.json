{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Total restaurant counts by CLUE small area for Census year 2024",

  "width": 700,
  "height": 450,
  "background": "#f8f8f8",

  "title": {
    "text": "Food Venue Density Across Melbourne Activity Districts",
    "fontSize": 24,
    "anchor": "middle",
    "subtitle": "CLUE small area business counts (2024 filtered)"
  },

  "data": {
    "url": "data/restaurants.csv"
  },

  "transform": [
    {
      "filter": "datum['Census year'] == 2024"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "venue_count"
        }
      ],
      "groupby": ["CLUE small area"]
    }
  ],

  "mark": {
    "type": "bar",
    "cornerRadiusTopLeft": 5,
    "cornerRadiusTopRight": 5
  },

  "encoding": {
    "x": {
      "field": "CLUE small area",
      "type": "nominal",
      "sort": "-y",
      "axis": {
        "labelAngle": -35,
        "labelLimit": 200,
        "title": "Suburb / Activity Area"
      }
    },

    "y": {
      "field": "venue_count",
      "type": "quantitative",
      "axis": {
        "title": "Total Venue Count",
        "grid": true
      }
    },

    "color": {
      "field": "venue_count",
      "type": "quantitative",
      "scale": {
        "scheme": "orangered"
      },
      "legend": {
        "title": "Venue Density"
      }
    },

    "tooltip": [
      {
        "field": "CLUE small area",
        "title": "Area"
      },
      {
        "field": "venue_count",
        "title": "Total Venues"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    }
  }
}