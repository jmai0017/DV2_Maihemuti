          "title": "Accessibility Score (out of 10)",
          "scale": {"domain": [0, 10]}
        },
        "color": {"field": "Area", "type": "nominal", "scale": {"scheme": "blues"}}
      }
    },
    {
      "mark": {"type": "text", "align": "center", "baseline": "middle", "fontSize": 14, "fontWeight": "bold"},
      "encoding": {
        "x": {"field": "Area", "type": "ordinal"},
        "y": {"field": "Normalized", "type": "quantitative"},
        "text": {"field": "Normalized", "format": ".1f"}
      }
    }
  ]
}